{
  "realm": "cloudswitch",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "cloudswitch-api",
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "cloudswitch-web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {
          "name": "cloudswitch-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "cloudswitch-api", "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    },
    {
      "clientId": "cloudswitch-dev",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "cloudswitch-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "cloudswitch-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "cloudswitch-api", "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "email": "developer@example.test",
      "credentials": [{"type": "password", "value": "cloudswitch-dev", "temporary": false}]
    }
  ]
}
